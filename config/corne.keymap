#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include "constants.h"
#define HOST_OS LINUX

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"
#include "../behaviors/soft-off.dtsi"
#include "../behaviors/hold-tap.dtsi"
#include "../behaviors/thumb-mods.dtsi"
#include "../behaviors/macros.dtsi"
#include "../behaviors/mod-morph.dtsi"
#include "../behaviors/combos.dtsi"

/////////////////////////////////////////////////////////////////////////////
// LAYER 0 — AZERTY (base)
/////////////////////////////////////////////////////////////////////////////
// Design: dedicated ESC / TAB / SHIFT on left outer column,
//         CTL & ALT on left thumbs, ALT/dbl-tap-GUI on right outer column.
//
// ╭─────────┬─────┬─────┬─────┬─────┬─────╮ ╭─────┬─────┬─────┬─────┬─────┬───────╮
// │  ESC    │  A  │  Z  │  E  │  R  │  T  │ │  Y  │  U  │  I  │  O  │  P  │  XXX   │
// ├─────────┼─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┼───────┤
// │  TAB    │  Q  │  S  │  D  │  F  │  G  │ │  H  │  J  │  K  │  L  │  M  │ alt*  │
// ├─────────┼─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┼───────┤
// │  SFT    │  W  │  X  │  C  │  V  │  B  │ │  N  │  ,  │  ;  │  :  │  !  │  XXX   │
// ╰─────────┴─────┴─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┴─────┴───────╯
//                       │ CTL │ ALT │NAV← │ │→NUM │ENT  │alt* │
//                       ╰─────┴─────┴─────╯ ╰─────┴─────┴─────╯
//  CTL  = hold LCTL / tap Space
//  ALT  = hold LALT / tap Backspace
//  NAV← = hold NAV layer / tap Enter
//  →NUM = hold NUM layer / tap Tab
//  ENT  = Enter
//  alt* = tap ALT(RALT) / double-tap → Windows/GUI

ZMK_LAYER(AZERTY,
// ╭───────────┬───────────┬───────────┬───────────┬────────────┬───────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────┬───────────╮
     &kp ESC      &kp A       &kp Z       &kp E       &kp R        &kp T          &kp Y       &kp U         &kp I         &kp O        &kp P       XXX
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┼───────────┤
     &kp TAB      &kp Q       &kp S       &kp D       &kp F        &kp G          &kp H       &kp J         &kp K         &kp L        &kp M       &right_alt_gui
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┼───────────┤
     &kp LSHFT    &kp W       &kp X       &kp C       &kp V        &kp B          &kp N       &kp COMMA     &kp SEMI      &kp COLON    &kp EXCL    XXX
// ╰───────────┴───────────┴───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴───────────╯
                                     &hm_ctl CL SPACE &hm_alt AL BSPC &lt NAV RET     &lt NUM TAB   &kp RET       &right_alt_gui
//                                 ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

/////////////////////////////////////////////////////////////////////////////
// LAYER 1 — QWERTY
/////////////////////////////////////////////////////////////////////////////
// Same thumb/mod layout as AZERTY, only alpha positions change.

ZMK_LAYER(QWERTY,
// ╭───────────┬───────────┬───────────┬───────────┬────────────┬───────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────┬───────────╮
     &kp ESC      &kp Q       &kp W       &kp E       &kp R        &kp T          &kp Y       &kp U         &kp I         &kp O        &kp P       XXX
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┼───────────┤
     &kp TAB      &kp A       &kp S       &kp D       &kp F        &kp G          &kp H       &kp J         &kp K         &kp L        &kp SEMI    &right_alt_gui
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┼───────────┤
     &kp LSHFT    &kp Z       &kp X       &kp C       &kp V        &kp B          &kp N       &kp M         &kp COMMA     &kp DOT      &kp FSLH    XXX
// ╰───────────┴───────────┴───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴───────────╯
                                     &hm_ctl CL SPACE &hm_alt AL BSPC &lt NAV RET     &lt NUM TAB   &kp RET       &right_alt_gui
//                                 ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

/////////////////////////////////////////////////////////////////////////////
// LAYER 2 — Navigation
/////////////////////////////////////////////////////////////////////////////
ZMK_LAYER(Nav,
// ╭───────────┬───────────┬───────────┬───────────┬────────────┬───────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────┬───────────╮
     XXX          &out OUT_TOG XXX         XXX         XXX          &bt BT_CLR     XXX         XXX           XXX           XXX          XXX         XXX
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┼───────────┤
     XXX          &kp LGUI    &kp C_PREV  &kp C_PP    &kp C_NEXT   XXX            &kp LEFT    &kp DOWN      &kp UP        &kp RIGHT    &kp INS     XXX
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┼───────────┤
     XXX          &bt BT_PRV  &bt BT_NXT &kp C_VOL_DN &kp C_VOL_UP XXX            &kp HOME    &kp PG_DN     &kp PG_UP     &kp END      &kp SLCK    XXX
// ╰───────────┴───────────┴───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴───────────╯
                                     &hm_ctl CL SPACE &hm_alt AL BSPC ___              ___          &kp RET       XXX
//                                 ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

/////////////////////////////////////////////////////////////////////////////
// LAYER 3 — Numbers & Symbols
/////////////////////////////////////////////////////////////////////////////
ZMK_LAYER(Numbers,
// ╭───────────┬───────────┬───────────┬───────────┬────────────┬───────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────┬───────────╮
     XXX          &kp F1      &kp F2      &kp F3      &kp F4       &kp F5         &kp F6      &kp F7        &kp F8        &kp F9       &kp F10     XXX
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┼───────────┤
     XXX          &kp N1      &kp N2      &kp N3      &kp N4       &kp N5         &kp N6      &kp N7        &kp N8        &kp N9       &kp N0      XXX
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┼───────────┤
     XXX          &kp MINUS   &kp EQUAL   &kp LBKT    &kp RBKT     &kp BSLH       &kp GRAVE   &kp COMMA     &kp DOT       &kp SEMI     &kp SQT     XXX
// ╰───────────┴───────────┴───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴───────────╯
                                     &hm_ctl CL SPACE &hm_alt AL BSPC ___              ___          &kp RET       XXX
//                                 ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)
