#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include "constants.h"
#define HOST_OS LINUX

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"
#include "../behaviors/soft-off.dtsi"
#include "../behaviors/hold-tap.dtsi"
#include "../behaviors/macros.dtsi"
#include "../behaviors/mod-morph.dtsi"
#include "../behaviors/combos.dtsi"

// Tap-dance: right ALT — 1 tap = RALT, 2 taps = RGUI (Windows key)
ZMK_TAP_DANCE(alt_gui,
    tapping-term-ms = <200>;
    bindings = <&kp RALT>, <&kp RGUI>;
)

/////////////////////////////////////////////////////////////////////////////
// LAYER 0 — QWERTY (base)
/////////////////////////////////////////////////////////////////////////////
ZMK_LAYER(QWERTY,
// ╭───────────┬───────────┬───────────┬───────────┬────────────┬───────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────┬───────────╮
     &kp ESC      &kp Q       &kp W       &kp E       &kp R        &kp T          &kp Y       &kp U         &kp I         &kp O        &kp P       &kp BSPC
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┼───────────┤
     &kp LSHFT    &kp A       &kp S       &kp D       &kp F        &kp G          &kp H       &kp J         &kp K         &kp L        &kp SEMI    &kp RSHFT
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┼───────────┤
     &kp LCTRL    &kp Z       &kp X       &kp C       &kp V        &kp B          &kp N       &kp M         &kp SQT       &kp DOT      &kp FSLH    &kp DEL
// ╰───────────┴───────────┴───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴───────────╯
                                     XXX          XXX          &lt NAV LALT    &alt_gui     &kp RGUI     XXX
//                                 ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

/////////////////////////////////////////////////////////////////////////////
// LAYER 1 — AZERTY
/////////////////////////////////////////////////////////////////////////////
ZMK_LAYER(AZERTY,
// ╭───────────┬───────────┬───────────┬───────────┬────────────┬───────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────┬───────────╮
     &kp ESC      &kp A       &kp Z       &kp E       &kp R        &kp T          &kp Y       &kp U         &kp I         &kp O        &kp P       &kp BSPC
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┬─────────────┼────────────┼────────────┼───────────┤
     &kp LSHFT    &kp Q       &kp S       &kp D       &kp F        &kp G          &kp H       &kp J         &kp K         &kp L        &kp M       &kp RSHFT
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┬─────────────┼────────────┼────────────┼───────────┤
     &kp LCTRL    &kp W       &kp X       &kp C       &kp V        &kp B          &kp N       &kp COMMA     &kp SEMI      &kp COLON    &kp EXCL    &kp DEL
// ╰───────────┴───────────┴───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴───────────╯
                                     XXX          XXX          &lt NAV LALT    &alt_gui     &kp RGUI     XXX
//                                 ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

/////////////////////////////////////////////////////////////////////////////
// LAYER 2 — Navigation
/////////////////////////////////////////////////////////////////////////////
ZMK_LAYER(Nav,
// ╭───────────┬───────────┬───────────┬───────────┬────────────┬───────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────┬───────────╮
     XXX          &out OUT_TOG XXX         XXX         XXX          &bt BT_CLR     XXX         XXX           XXX           XXX          XXX         XXX
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┬─────────────┼────────────┼────────────┼───────────┤
     XXX          &kp LGUI    &kp C_PREV  &kp C_PP    &kp C_NEXT   XXX            &kp LEFT    &kp DOWN      &kp UP        &kp RIGHT    &kp INS     XXX
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┼───────────┤
     XXX          &bt BT_PRV  &bt BT_NXT &kp C_VOL_DN &kp C_VOL_UP XXX            &kp HOME    &kp PG_DN     &kp PG_UP     &kp END      &kp SLCK    XXX
// ╰───────────┴───────────┴───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴───────────╯
                                     XXX          XXX          ___              ___          &kp RET       XXX
//                                 ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

/////////////////////////////////////////////////////////////////////////////
// LAYER 3 — Numbers & Symbols
/////////////////////////////////////////////////////////////////////////////
ZMK_LAYER(Numbers,
// ╭───────────┬───────────┬───────────┬───────────┬────────────┬───────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────┬───────────╮
     XXX          &kp F1      &kp F2      &kp F3      &kp F4       &kp F5         &kp F6      &kp F7        &kp F8        &kp F9       &kp F10     XXX
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┬─────────────┼────────────┼────────────┼───────────┤
     XXX          &kp N1      &kp N2      &kp N3      &kp N4       &kp N5         &kp N6      &kp N7        &kp N8        &kp N9       &kp N0      XXX
// ├───────────┼───────────┼───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┬─────────────┼────────────┼────────────┼───────────┤
     XXX          &kp MINUS   &kp EQUAL   &kp LBKT    &kp RBKT     &kp BSLH       &kp GRAVE   &kp COMMA     &kp DOT       &kp SEMI     &kp SQT     XXX
// ╰───────────┴───────────┴───────────┼───────────┼────────────┼───────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴───────────╯
                                     XXX          XXX          ___              ___          &kp RET       XXX
//                                 ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)
