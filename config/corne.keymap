#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        // Tap-dance: right thumb — 1 tap = RALT, 2 taps = RGUI (Windows key)

        alt_gui: alt_gui {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RALT>, <&kp RGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_cut {
            timeout-ms = <40>;
            bindings = <&kp X>;
            key-positions = <16 17>;
            layers = <0 1>;
        };

        combo_copy {
            timeout-ms = <40>;
            bindings = <&kp C>;
            key-positions = <15 16>;
            layers = <0 1>;
        };

        combo_paste {
            timeout-ms = <40>;
            bindings = <&kp V>;
            key-positions = <17 21>;
            layers = <0 1>;
        };

        combo_capslock {
            timeout-ms = <40>;
            bindings = <&kp CLCK>;
            key-positions = <0 11>;
            layers = <0 1>;
        };

        combo_capsword {
            timeout-ms = <40>;
            bindings = <&caps_word>;
            key-positions = <9 29>;
            layers = <0 1>;
        };

        combo_to_azerty {
            timeout-ms = <40>;
            bindings = <&to 1>;
            key-positions = <6 5>;
            layers = <0>;
        };

        combo_to_qwerty {
            timeout-ms = <40>;
            bindings = <&to 0>;
            key-positions = <17 18>;
            layers = <1>;
        };

        combo_nav_toggle {
            timeout-ms = <40>;
            bindings = <&tog 2>;
            key-positions = <18 19>;
            layers = <0 1 2>;
        };

        combo_num_toggle {
            timeout-ms = <40>;
            bindings = <&tog 3>;
            key-positions = <30 31>;
            layers = <0 1 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0 — QWERTY (base)

        default_layer {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T         &kp Y     &kp U     &kp I    &kp O    &kp P     &kp BSPC
&kp LSHFT  &kp A  &kp S  &kp D  &kp F  &kp G         &kp H     &kp J     &kp K    &kp L    &kp SEMI  &kp RSHFT
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B         &kp N     &kp M     &kp SQT  &kp DOT  &kp FSLH  &kp DEL
                         &none  &none  &lt 2 LALT    &alt_gui  &kp RGUI  &none
            >;
        };

        // Layer 1 — AZERTY

        azerty {
            bindings = <
&kp ESC    &kp A  &kp Z  &kp E  &kp R  &kp T         &kp Y     &kp U      &kp I     &kp O      &kp P     &kp BSPC
&kp LSHFT  &kp Q  &kp S  &kp D  &kp F  &kp G         &kp H     &kp J      &kp K     &kp L      &kp M     &kp RSHFT
&kp LCTRL  &kp W  &kp X  &kp C  &kp V  &kp B         &kp N     &kp COMMA  &kp SEMI  &kp COLON  &kp EXCL  &kp DEL
                         &none  &none  &lt 2 LALT    &alt_gui  &kp RGUI   &none
            >;
        };

        // Layer 2 — Navigation

        nav_layer {
            bindings = <
&none  &out OUT_TOG  &none       &none         &none         &none     &none     &none      &none      &none      &none     &none
&none  &kp LGUI      &kp C_PREV  &kp C_PP      &kp C_NEXT    &none     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp INS   &none
&none  &bt BT_PRV    &bt BT_NXT  &kp C_VOL_DN  &kp C_VOL_UP  &none     &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp SLCK  &none
                                 &none         &none         &trans    &none     &kp RET    &none
            >;
        };

        // Layer 3 — Numbers & Symbols

        num_layer {
            bindings = <
&none  &kp F1     &kp F2     &kp F3    &kp F4    &kp F5      &kp F6     &kp F7     &kp F8   &kp F9    &kp F10  &none
&none  &kp N1     &kp N2     &kp N3    &kp N4    &kp N5      &kp N6     &kp N7     &kp N8   &kp N9    &kp N0   &none
&none  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH    &kp GRAVE  &kp COMMA  &kp DOT  &kp SEMI  &kp SQT  &none
                             &none     &none     &trans      &none      &kp RET    &none
            >;
        };
    };
};

// Soft-off config

&soft_off {
    /delete-property/ split-peripheral-off-on-press;

    hold-time-ms = <3000>;
};
