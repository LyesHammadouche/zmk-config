#include <dt-bindings/zmk/modifiers.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        /* Direct apostrophe = dead key SQT + SPACE */
        macro_apostrophe: macro_apostrophe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp SQT &kp SPACE>;
        };

        /* .com */
        macro_dotcom: macro_dotcom {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <10>;
            wait-ms = <10>;
            bindings = <&kp DOT &kp C &kp O &kp M>;
        };

        /* ç = dead key SQT + C (US International) */
        macro_ccedilla: macro_ccedilla {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp SQT &kp C>;
        };

        /* Ç = SQT + C shifté (pattern macro_e_acute_cap : le Shift physique
         * transformerait SQT en tréma mort ¨) */
        macro_ccedilla_cap: macro_ccedilla_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp SQT &kp LS(C)>;
        };

        /* ==== Couche signes (L4) : accents directs ==== */
        /* ê = CARET + E · Ê = CARET + LS(E) (Shift+GRAVE/SQT dérivent : morph requis) */
        macro_e_circ: macro_e_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp CARET &kp E>;
        };
        macro_e_circ_cap: macro_e_circ_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp CARET &kp LS(E)>;
        };
        /* ô = CARET + O · Ô = CARET + LS(O) */
        macro_o_circ: macro_o_circ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp CARET &kp O>;
        };
        macro_o_circ_cap: macro_o_circ_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp CARET &kp LS(O)>;
        };
        /* à = GRAVE + A · À = GRAVE + LS(A) (Shift+GRAVE = ~ mort en US-Intl) */
        macro_a_grave: macro_a_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp GRAVE &kp A>;
        };
        macro_a_grave_cap: macro_a_grave_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp GRAVE &kp LS(A)>;
        };
        /* ù = GRAVE + U · Ù = GRAVE + LS(U) */
        macro_u_grave: macro_u_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp GRAVE &kp U>;
        };
        macro_u_grave_cap: macro_u_grave_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp GRAVE &kp LS(U)>;
        };

        /* ==== Correction Lyes 06/11 : e accent AIGU sur E, e accent GRAVE sur R (L4) ==== */
        /* é = SQT + E · É = SQT + LS(E) */
        macro_e_aigu: macro_e_aigu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp SQT &kp E>;
        };
        macro_e_aigu_cap: macro_e_aigu_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp SQT &kp LS(E)>;
        };
        /* è = GRAVE + E · È = GRAVE + LS(E) */
        macro_e_grave: macro_e_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp GRAVE &kp E>;
        };
        macro_e_grave_cap: macro_e_grave_cap {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <20>;
            wait-ms = <50>;
            bindings = <&kp GRAVE &kp LS(E)>;
        };
        /* ± = Alt+0177 (pattern Alt-codes, NumLock requis) */
        macro_plusminus: macro_plusminus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_7 &kp KP_NUMBER_7>, <&macro_release &kp LALT>;
        };

        /* ==== Couche signes : monnaies/degré/guillemets = Alt-codes Windows ====
         * Pattern officiel ZMK (doc Macros § Unicode Sequences) : Alt+0NNN pavé
         * numérique, wait/tap 40 ms (anti-regroupement BLE). NumLock requis. */
        macro_euro: macro_euro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_8>, <&macro_release &kp LALT>;
        };
        macro_livre: macro_livre {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_3>, <&macro_release &kp LALT>;
        };
        macro_yen: macro_yen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_6 &kp KP_NUMBER_5>, <&macro_release &kp LALT>;
        };
        macro_degre: macro_degre {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_7 &kp KP_NUMBER_6>, <&macro_release &kp LALT>;
        };
        macro_guillemet_o: macro_guillemet_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_7 &kp KP_NUMBER_1>, <&macro_release &kp LALT>;
        };
        macro_guillemet_f: macro_guillemet_f {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&macro_press &kp LALT>, <&macro_tap &kp KP_NUMBER_0 &kp KP_NUMBER_1 &kp KP_NUMBER_8 &kp KP_NUMBER_7>, <&macro_release &kp LALT>;
        };

        /* --- Tap dances --- */
        /* / : tap=/ · 2×=| · hold=\ — ressuscite tel quel (implantation d'origine) */
        slash_td: slash_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp FSLH>, <&kp LS(BSLH)>;
        };
        slash_behavior: slash_behavior {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&slash_td>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        /* ; tap=; · 2× = ' (apostrophe US-Intl) — pattern de l'ancienne apo_ht */
        semi_td: semi_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <220>;
            bindings = <&kp SEMI>, <&macro_apostrophe>;
        };

        /* Shift + ; = : (pattern apo_morph prouve en production) */
        semi_morph: semi_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&semi_td>, <&kp LS(SEMI)>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

        /* Grave dead key (tap) → è à ù · aigu dead key (2×) → á é í */
        grave_td: grave_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&kp GRAVE>, <&kp SQT>;
        };

        /* Apostrophe: tap=' (immediate), hold=; — parameterized hold-tap
         * (bindings = BARE phandles, keycodes passed at the reference site) */
        /* A: tap=a instant (Ctrl+A lag fix), hold=@ — À via L1 dead-key ` + a */

        /* --- Mod-morph: apostrophe with Shift → colon --- */
        e_aigu_morph: e_aigu_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_e_aigu>, <&macro_e_aigu_cap>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        e_grave_morph: e_grave_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_e_grave>, <&macro_e_grave_cap>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        a_grave_morph: a_grave_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_a_grave>, <&macro_a_grave_cap>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        u_grave_morph: u_grave_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_u_grave>, <&macro_u_grave_cap>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
        c_ced_morph: c_ced_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_ccedilla>, <&macro_ccedilla_cap>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };

    };

    combos {
        compatible = "zmk,combos";

        combo_capslock {
            timeout-ms = <40>;
            bindings = <&kp CLCK>;
            key-positions = <0 11>;
            layers = <0>;
        };

        combo_capsword {
            timeout-ms = <40>;
            bindings = <&caps_word>;
            key-positions = <30 29>;
            layers = <0>;
        };

        combo_nav_toggle {
            timeout-ms = <40>;
            bindings = <&tog 3>;
            key-positions = <9 10 11>;
            layers = <0 1 2 3>;
        };

        combo_numlock {
            bindings = <&kp KP_NUMLOCK>;
            key-positions = <0 12 11 23>;
            timeout-ms = <80>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        combo_bootloader_L {
            bindings = <&bootloader>;
            key-positions = <3 4 14 5>;
            timeout-ms = <100>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        combo_bootloader_R {
            bindings = <&bootloader>;
            key-positions = <6 7 8 21>;
            timeout-ms = <100>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <3 4>;
            timeout-ms = <40>;
            layers = <0>;
            require-prior-idle-ms = <250>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <16 15>;
            timeout-ms = <40>;
            layers = <0>;
            require-prior-idle-ms = <250>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <27 28>;
            timeout-ms = <40>;
            layers = <0>;
            require-prior-idle-ms = <250>;
        };

        combo_shift_a_tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
            timeout-ms = <30>;
            require-prior-idle-ms = <0>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "0";
            bindings = <
&kp ESCAPE  &kp Q                  &kp W                  &kp E     &kp R     &kp T    &kp Y      &kp U    &kp I      &kp O    &kp P                  &kp BSPC
&kp LSHFT  &kp A                   &kp S             &kp D                    &kp F     &kp G                &kp H      &kp J    &kp K      &kp L    &macro_apostrophe              &kp RSHFT
&kp LCTRL   &kp Z                  &kp X             &kp C                    &kp V     &kp B                &kp N      &kp M    &kp COMMA  &kp DOT         &slash_behavior BSLH 0  &kp DEL
                                                     &kp LALT                 &mo 1     &kp SPACE            &lt 3 RET  &mo 2    &kp RCTRL
            >;
        };

        num_layer {
            label = "1";
            bindings = <
&kp F1        &kp F2    &kp F3    &kp F4        &kp F5    &kp F6       &kp F7             &kp F8     &kp F9       &kp F10  &kp F11    &kp F12
&kp N0        &kp N1    &kp N2    &kp N3        &kp N4    &kp N5       &kp N6             &kp N7     &kp N8       &kp N9   &kp MINUS  &kp DEL
&kp QUESTION  &kp LPAR  &kp RPAR  &kp PIPE  &kp LEFT_BRACE  &kp RIGHT_BRACE     &kp DOUBLE_QUOTES  &kp CARET  &kp LS(SQT)  &grave_td  &kp UNDER  &kp EXCL
                                  &kp LEFT_ALT  &trans    &kp LSHFT    &kp DELETE         &mo 4      &kp RCTRL
            >;
        };

        fr_accents_signs {
            label = "2";
            bindings = <
&kp INSERT       &kp HOME   &kp PG_UP         &kp UP_ARROW    &kp PAGE_DOWN     &kp BSPC             &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp FSLH   &kp BSLH  &kp DEL
&kp TAB          &kp END    &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT_ARROW   &kp KP_DIVIDE       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp LT     &kp GT    &kp KP_MULTIPLY
&kp PRINTSCREEN  &kp LSHFT  &kp LEFT_CONTROL  &key_repeat     &kp LEFT_BRACKET  &kp RIGHT_BRACKET    &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp MINUS  &kp PLUS  &kp EQUAL
                                              &kp LSHFT       &mo 4             &kp UNDER            &kp KP_NUMBER_0  &kp RET          &kp KP_DOT
            >;
        };

        signes_layer {
            label = "4";
            bindings = <
&kp ESCAPE  &kp AT_SIGN   &kp AMPERSAND    &e_aigu_morph  &e_grave_morph  &kp TILDE    &macro_euro  &u_grave_morph  &macro_yen  &macro_degre  &kp PRCNT        &kp BSPC
&kp LSHFT   &a_grave_morph &kp DLLR        &kp HASH       &kp GRAVE      &kp SQT      &kp MINUS    &kp J           &macro_livre &kp L          &semi_morph      &kp RSHFT
&kp LCTRL   &kp Z          &kp STAR        &c_ced_morph   &kp LPAR       &macro_guillemet_o  &macro_guillemet_f &kp RPAR  &kp COMMA  &macro_dotcom  &macro_plusminus  &kp BSPC
                                             &kp LALT      &mo 4          &kp SPACE    &kp ENTER    &mo 4           &kp RCTRL
            >;
        };

        nav_layer {
            label = "3";
            bindings = <
&trans     &out OUT_TOG  &kp LC(LEFT)  &kp LC(RIGHT)  &kp LG(LEFT)  &kp LG(RIGHT)    &kp PAGE_DOWN   &kp DEL   &kp UP     &kp BSPC   &kp PAGE_UP  &trans
&trans     &kp LGUI      &kp C_PREV    &kp C_PP       &kp C_NEXT    &kp ESCAPE       &kp SCROLLLOCK  &kp LEFT  &kp DOWN   &kp RIGHT  &kp GRAVE    &trans
&kp LSHFT  &bt BT_PRV    &bt BT_NXT    &kp C_VOL_DN   &kp C_VOL_UP  &kp C_MUTE       &kp INS         &kp HOME  &kp INS    &kp END    &kp TILDE2   &kp RSHFT
                                       &kp LCTRL      &kp LEFT_ALT  &trans           &kp ENTER       &trans    &kp GRAVE
            >;
        };
    };
};

&soft_off {
    /delete-property/ split-peripheral-off-on-press;

    hold-time-ms = <3000>;
};
