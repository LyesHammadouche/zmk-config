// Combos for AZERTY/QWERTY Corne 42-key
#undef COMBO_TERM
#define COMBO_TERM 40
#define HR_TIMEOUT 30

/***********************
  ALL ALPHA LAYERS
***********************/

// CUT - Ctrl + X — V + B on left bottom row
ZMK_COMBO(cut, &kp LC(X), LB4 LB5, AZR QWE)

// COPY - Ctrl + C — C + V on left bottom row
ZMK_COMBO(copy, &kp LC(C), LB3 LB4, AZR QWE)

// PASTE - Ctrl + V — X + C on left bottom row
ZMK_COMBO(paste, &kp LC(V), LB2 LB3, AZR QWE)

// CAPS LOCK — D + K (middle fingers, home row, both hands)
ZMK_COMBO(capslock, &kp CAPSLOCK, LM3 RM2, AZR QWE)

// CAPS WORD — S + L (ring fingers, home row)
ZMK_COMBO(capsword, &caps_word, LM2 RM3, AZR QWE)

// AZERTY → QWERTY — F + H (index fingers, home row)
ZMK_COMBO(layout_to_qwe, &to QWE, LM4 RM0, AZR)

// QWERTY → AZERTY — F + H (index fingers, home row)
ZMK_COMBO(layout_to_azr, &to AZR, LM4 RM0, QWE)

// NAV toggle — both left thumbs
ZMK_COMBO(nav_toggle, &tog NAV, LH0 LH1, AZR QWE NAV)

/***********************
  NUMBERS LAYER
***********************/

// Fat arrow — on NAV layer
ZMK_COMBO(fat_arrow, &FAT_ARROW, LM1 LM2, NAV)
